{
  "name": "native-example-plugin",
  "version": "1.1.0",
  "description": "原生插件示例",
  "type": "module",
  "scripts": {
    "build": "bun build.js",
    "build:rust": "cargo build",
    "build:rust:release": "cargo build --release",
    "build:vue": "bun x vite build",
    "package": "bun build.js --package",
    "dev": "cargo watch -x build",
    "clean": "cargo clean && bun x rimraf dist dist-ui *.zip"
  },
  "keywords": [
    "aio-hub",
    "plugin",
    "native"
  ],
  "author": "AIO Hub Team",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "archiver": "^7.0.1",
    "fs-extra": "^11.2.0",
    "rimraf": "^5.0.7",
    "vite": "^8.0.16"
  }
}
